# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ───────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ───────────────────────────────────────────────────────
/.next/
/out/
/build

# ── PWA — generated at build time, never commit stale service workers ─────────
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# ── Environment & secrets — never commit real credentials ─────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT ignored — it is safe to commit as a template

# ── TypeScript ─────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ────────────────────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results

# ── Debug logs ─────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ── OS & editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
*.sublime-workspace
.idea/
*.swp
*.swo
*~

# ── Vercel deployment ─────────────────────────────────────────────────────────
.vercel

# ── AI tooling (Claude Code) — local session state, hooks, worktree refs ─────
# AGENTS.md and CLAUDE.md are kept — they are project-level instructions
# useful to any contributor running Claude Code on this repo.
.claude/

# ── Scratch / dev workspace ───────────────────────────────────────────────────
/scratch/

# ── Auto-generated AI session memory (not project documentation) ──────────────
PROJECT_MEMORY.md

# ── Supabase local dev artifacts ─────────────────────────────────────────────
# The /supabase/migrations/ folder IS committed — it is the source of truth.
# Local Supabase CLI state files are not.
supabase/.branches/
supabase/.temp/
.supabase/

# ── Export / generated HTML snapshots ────────────────────────────────────────
/exported/
/published-html/
