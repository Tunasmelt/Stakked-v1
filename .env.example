# Supabase — required for auth, cloud save, and publish.
# Stakked runs fully offline without these (editor works, cloud features disabled).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI providers — at least one required for AI features (layout generation, theme
# suggestions, page summaries). Both are free-tier.
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
AI_DEFAULT_PROVIDER=gemini

# Image search (optional) — enables the Pexels image search panel.
PEXELS_API_KEY=your-pexels-key

# Site URL — base URL used for published share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
